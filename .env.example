# URL pública local da aplicação, usada pelo Better Auth
BETTER_AUTH_URL="http://localhost:3000"

# Gere um segredo aleatório com pelo menos 32 caracteres: openssl rand -base64 32
BETTER_AUTH_SECRET="substitua-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# URL pooled para consultas da aplicação
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler/BANCO?sslmode=verify-full"

# URL direta, sem -pooler, usada pelo Prisma CLI para migrations
DIRECT_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=verify-full"
